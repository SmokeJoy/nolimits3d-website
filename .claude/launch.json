{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "atlas-web-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@atlas/web", "dev"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "atlas-web-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@atlas/web", "preview"],
      "port": 4173,
      "autoPort": true
    },
    {
      "name": "legacy-web-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/legacy-web", "run", "preview", "--", "--port", "4199", "--strictPort"],
      "port": 4199,
      "autoPort": false
    }
  ]
}

{
  "name": "nolimits3d-platform",
  "version": "0.0.0",
  "private": true,
  "description": "NoLimits3D Website Platform monorepo",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "9.15.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "dependency:audit": "node scripts/guards/dependency-audit.mjs",
    "format:check": "prettier --check --ignore-unknown --no-error-on-unmatched-pattern package.json pnpm-workspace.yaml tsconfig.json eslint.config.js .prettierrc .env.example .github/**/* apps/**/* docs/source-bindings/**/* packages/**/* scripts/guards/**/* supabase/**/*",
    "guard:migrations": "node scripts/guards/migration-guard.mjs",
    "guard:scope": "node scripts/guards/scope-guard.mjs",
    "guard:source-bindings": "node scripts/guards/source-binding-guard.mjs",
    "lint": "eslint . --max-warnings=0",
    "secret:scan": "node scripts/guards/secret-scan.mjs",
    "supabase:config:check": "supabase services --output json",
    "supabase:start": "supabase start",
    "supabase:status": "supabase status --output json",
    "supabase:stop": "supabase stop",
    "test": "node --test scripts/guards/guards.test.mjs && pnpm --filter @atlas/ui --if-present test && pnpm --filter @atlas/web --if-present test",
    "toolchain:check": "node scripts/guards/toolchain-guard.mjs",
    "typecheck": "pnpm --recursive --if-present typecheck"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.9",
      "@hono/node-server@<2.0.5": ">=2.0.5",
      "fast-uri@>=3.0.0 <=3.1.3": ">=3.1.4",
      "postcss@<=8.5.22": ">=8.5.23",
      "undici@>=7.0.0 <7.29.0": ">=7.29.0",
      "fast-uri@>=3.0.0 <3.1.5": ">=3.1.5",
      "ip-address@<=10.3.0": ">=10.3.1",
      "ip-address@>=10.1.1 <=10.2.1": ">=10.2.2",
      "ip-address@>=10.1.1 <=10.2.0": ">=10.2.1",
      "hono@<4.12.34": ">=4.12.34"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.1",
    "eslint": "10.7.0",
    "globals": "17.7.0",
    "prettier": "3.9.5",
    "supabase": "2.109.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0"
  }
}

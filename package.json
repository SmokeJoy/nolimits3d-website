{
  "name": "nolimits3d-platform",
  "version": "0.0.0",
  "private": true,
  "description": "NoLimits3D Website Platform monorepo",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "9.15.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "format:check": "prettier --check --ignore-unknown --no-error-on-unmatched-pattern package.json pnpm-workspace.yaml tsconfig.json eslint.config.js .prettierrc .github/**/* apps/**/* packages/**/* scripts/guards/**/*",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.1",
    "eslint": "10.7.0",
    "globals": "17.7.0",
    "prettier": "3.9.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0"
  }
}

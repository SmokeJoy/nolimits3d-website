{
  "name": "nolimits3d-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Sito web professionale per NoLimits3D - Servizio di stampa 3D",
  "keywords": [
    "stampa-3d",
    "prototipi",
    "react",
    "typescript",
    "vite"
  ],
  "author": "NoLimits3D",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "npm run build && npx vite-bundle-analyzer dist/assets/*.js",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "optimize-images": "node scripts/optimize-images.cjs",
    "optimize-images-old": "imagemin public/images/*.{jpg,png,gif} --out-dir=public/images --plugin=imagemin-mozjpeg --plugin=imagemin-pngquant",
    "audit": "npm audit --audit-level=moderate",
    "test": "echo 'No tests specified' && exit 0",
    "lhci:collect": "lhci collect",
    "lhci:upload": "lhci upload",
    "lhci:assert": "lhci assert",
    "lhci:autorun": "lhci autorun",
    "analyze:vitals": "npm run build && npm run lhci:autorun",
    "perf:check": "npm run build && lhci autorun --config=lighthouserc.js"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@react-three/drei": "9.113.0",
    "@react-three/fiber": "8.15.19",
    "@types/react-router-dom": "^5.3.3",
    "html2pdf.js": "^0.10.3",
    "lucide-react": "^0.344.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-intersection-observer": "^9.5.3",
    "react-markdown": "^10.1.0",
    "react-medium-image-zoom": "^5.1.10",
    "react-reconciler": "^0.29.2",
    "react-router-dom": "^7.6.2",
    "serp": "^2.2.2",
    "three": "0.167.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@lhci/cli": "^0.15.1",
    "@types/node": "^20.11.24",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "postcss-purgecss": "^5.0.0",
    "rollup": "^4.44.2",
    "source-map-explorer": "^2.5.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vite-imagetools": "^7.1.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-pwa": "^0.19.2",
    "workbox-precaching": "^7.0.0",
    "workbox-routing": "^7.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.44.2",
    "@rollup/rollup-win32-x64-msvc": "^4.44.2"
  },
  "resolutions": {
    "rollup": "npm:@rollup/wasm-node"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
